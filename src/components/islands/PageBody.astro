---
import { tinaField } from "@tinacms/astro/tina-field";
import type { HomeQuery } from "../../../tina/__generated__/types";

interface Props {
  data?: HomeQuery["home"] | null;
}

const { data } = Astro.props;
---

{data && (
  <>
    <div class="ambient-contours" aria-hidden="true">
      <svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
        <path class="contour c1" d="M-50,650 C150,600 250,700 450,640 C650,580 750,660 950,600 C1050,570 1150,590 1250,560"/>
        <path class="contour c2" d="M-50,560 C180,500 300,610 500,540 C700,470 780,560 980,500 C1080,470 1150,490 1250,460"/>
        <path class="contour c3" d="M-50,470 C200,400 320,520 520,440 C720,360 800,460 1000,390 C1100,355 1160,380 1250,350"/>
        <path class="contour c4" d="M-50,380 C220,300 340,430 540,340 C740,250 820,360 1020,280 C1110,245 1170,270 1250,240"/>
        <path class="contour c5" d="M-50,290 C240,200 360,340 560,240 C760,140 840,260 1040,170 C1120,135 1180,160 1250,130"/>
      </svg>
    </div>

    <nav class="nav nav-on-dark">
      <a href="#top" class="nav-mark">
        <span class="nav-logo-box" data-tina-field={tinaField(data.nav, "logoInitials")}>{data.nav?.logoInitials}</span>
        <span data-tina-field={tinaField(data.nav, "name")}>{data.nav?.name}</span>
      </a>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#certifications">Certs</a>
        <a href="#projects">Projects</a>
        <a href="#" data-open-contact>Contact</a>
      </div>
      <button class="nav-toggle" aria-label="Toggle menu">
        <span></span>
      </button>
    </nav>

    <header class="hero hero-dark" id="top">
      <div class="hero-bg" aria-hidden="true">
        <svg class="hero-wave" viewBox="0 0 900 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path d="M 560,-60 C 720,110 460,260 630,410 C 800,560 520,700 660,880 C 720,950 690,1000 660,1060" stroke="#141414" stroke-width="190" fill="none" stroke-linecap="round"/>
          <path d="M 505,-60 C 665,120 405,270 575,420 C 745,570 465,710 610,890" stroke="#232323" stroke-width="155" fill="none" stroke-linecap="round"/>
          <path d="M 460,-60 C 620,130 360,280 530,430 C 700,580 420,720 570,900" stroke="#2e2e2e" stroke-width="120" fill="none" stroke-linecap="round"/>
          <path d="M 415,-60 C 575,140 315,290 485,440 C 655,590 375,730 525,910" stroke="#3b3b3b" stroke-width="88" fill="none" stroke-linecap="round"/>
          <path d="M 370,-60 C 530,150 270,300 440,450 C 610,600 330,740 480,920" stroke="#c9a26d" stroke-width="52" fill="none" stroke-linecap="round" opacity="0.92"/>
        </svg>
        <div class="hero-bg-scrim"></div>
      </div>

      <div class="hero-photo" aria-hidden="true">
        <img src="/assets/kakai_cropped.png" alt="">
      </div>

      <div class="hero-robot" aria-hidden="true">
        <img src={data.hero?.robotImage} alt="" data-tina-field={tinaField(data.hero, "robotImage")} />
      </div>

      <div class="hero-inner">
        <div class="hero-text">
          <div class="badge-row">
            <a href="#" class="badge badge-dark" data-open-contact data-tina-field={tinaField(data.hero, "badgeWorkText")}>{data.hero?.badgeWorkText}</a>
            <a href="#projects" class="badge badge-dark badge-link" data-tina-field={tinaField(data.hero, "badgeProjectsText")}>{data.hero?.badgeProjectsText}</a>
          </div>
          <p class="eyebrow mono eyebrow-dark" data-tina-field={tinaField(data.hero, "eyebrow")}>{data.hero?.eyebrow}</p>
          <h1 class="hero-headline">
            <span class="line" data-tina-field={tinaField(data.hero, "headlineLine1")}>{data.hero?.headlineLine1}</span>
            <span class="line" data-tina-field={tinaField(data.hero, "headlineLine2")}>{data.hero?.headlineLine2}</span>
            <span class="line accent-script" data-tina-field={tinaField(data.hero, "headlineLine3")}>{data.hero?.headlineLine3}</span>
          </h1>
          <p class="hero-lede hero-lede-dark" data-tina-field={tinaField(data.hero, "lede")}>{data.hero?.lede}</p>
          <p class="open-note open-note-dark" data-tina-field={tinaField(data.hero, "openNote")}>{data.hero?.openNote}</p>
          <div class="hero-actions">
            <a href="#" class="btn btn-primary" data-open-contact data-tina-field={tinaField(data.hero, "ctaPrimaryText")}>{data.hero?.ctaPrimaryText}</a>
            <a href="#skills" class="btn btn-ghost btn-ghost-dark" data-tina-field={tinaField(data.hero, "ctaSecondaryText")}>{data.hero?.ctaSecondaryText}</a>
          </div>
        </div>
      </div>

      <div class="hero-dots" aria-hidden="true">
        <span class="is-active"></span>
        <span></span>
        <span></span>
      </div>
    </header>

    <main>
      <section class="section reveal" id="about">
        <div class="section-head">
          <span class="section-index mono">About</span>
          <h2>What I work on</h2>
        </div>
        <div class="glass" style="padding: 32px 34px;">
          <p style="font-size: 1.02rem; color: var(--ink-soft);" data-tina-field={tinaField(data.about, "paragraph")}>{data.about?.paragraph}</p>
          <div class="about-highlight">
            <span class="icon-wrap" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l5 5v13H6z"/><path d="M14 3v5h5"/><path d="M9 13l2 2 4-4"/></svg>
            </span>
            <div>
              <strong data-tina-field={tinaField(data.about, "topSkillsLabel")}>{data.about?.topSkillsLabel}</strong>
              <span data-tina-field={tinaField(data.about, "topSkillsText")}>{data.about?.topSkillsText}</span>
            </div>
          </div>
          <div class="about-meta-row">
            <span class="pill mono" data-tina-field={tinaField(data.about, "pillRole")}>{data.about?.pillRole}</span>
            <span class="pill mono" data-tina-field={tinaField(data.about, "pillLocation")}>{data.about?.pillLocation}</span>
            <span class="pill mono" data-tina-field={tinaField(data.about, "pillConnections")}>{data.about?.pillConnections}</span>
          </div>
        </div>
      </section>

      <section class="section reveal" id="experience">
        <div class="section-head">
          <span class="section-index mono">Experience</span>
          <h2>Where I've worked</h2>
        </div>
        <div class="timeline">
          {data.experience?.map((item, i) => item && (
            <div class="timeline-item glass">
              {item.logo && (
                <div class="timeline-logo">
                  <img src={item.logo} alt="" data-tina-field={tinaField(item, "logo")} />
                </div>
              )}
              <div class="timeline-body">
                <h3 data-tina-field={tinaField(item, "title")}>{item.title}</h3>
                <div class="timeline-org" data-tina-field={tinaField(item, "org")}>{item.org}</div>
                <span class="timeline-date-inline mono" data-tina-field={tinaField(item, "dates")}>{item.dates}</span>
                <p class="timeline-desc" data-tina-field={tinaField(item, "description")}>{item.description}</p>
                <div class="tag-row">
                  {item.tags?.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="section reveal" id="education">
        <div class="section-head">
          <span class="section-index mono">Education</span>
          <h2>Academic background</h2>
        </div>
        <div class="education-list">
          {data.education?.map((item, i) => item && (
            <div class="education-item glass">
              {item.logo && (
                <div class="timeline-logo">
                  <img src={item.logo} alt="" data-tina-field={tinaField(item, "logo")} />
                </div>
              )}
              <div>
                <h3 data-tina-field={tinaField(item, "title")}>{item.title}</h3>
                <div class="education-degree" data-tina-field={tinaField(item, "institution")}>{item.institution}</div>
                <span class="timeline-date-inline mono" data-tina-field={tinaField(item, "dates")}>{item.dates}</span>
                <div class="education-detail" data-tina-field={tinaField(item, "detail")}>{item.detail}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="section reveal" id="skills">
        <div class="section-head">
          <span class="section-index mono">Skills</span>
          <h2>Top technical skills</h2>
        </div>
        <ul class="skills-grid" data-tina-field={tinaField(data, "skills")}>
          {data.skills?.map((skill) => <li class="glass">{skill}</li>)}
        </ul>
      </section>

      <section class="section reveal" id="certifications">
        <div class="section-head">
          <span class="section-index mono">Certifications</span>
          <h2>Licenses &amp; certifications</h2>
        </div>
        <ul class="cert-list">
          {data.certifications?.map((item) => item && (
            <li class:list={["glass", item.logo && "cert-with-logo"]}>
              {item.logo && (
                <div class="cert-logo">
                  <img src={item.logo} alt="" data-tina-field={tinaField(item, "logo")} />
                </div>
              )}
              <div class="cert-body">
                <span class="cert-name" data-tina-field={tinaField(item, "name")}>{item.name}</span>
                <span class="cert-meta" data-tina-field={tinaField(item, "meta")}>{item.meta}</span>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="section reveal" id="projects">
        <div class="section-head">
          <span class="section-index mono">Projects</span>
          <h2>Things I've built</h2>
        </div>
        <div class="project-grid">
          {data.projects?.map((item) => item && (
            <div class="project-card glass">
              {item.period && <div class="project-period mono" data-tina-field={tinaField(item, "period")}>{item.period}</div>}
              <h3 data-tina-field={tinaField(item, "title")}>{item.title}</h3>
              <div class="project-affil">
                {item.affilLogo && <img src={item.affilLogo} alt="" data-tina-field={tinaField(item, "affilLogo")} />}
                <span data-tina-field={tinaField(item, "affilText")}>{item.affilText}</span>
              </div>
              <p data-tina-field={tinaField(item, "description")}>{item.description}</p>
              <div class="tag-row">
                {item.tags?.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>&copy; <span id="year"></span> <span data-tina-field={tinaField(data.contact, "footerName")}>{data.contact?.footerName}</span> · <span data-tina-field={tinaField(data.contact, "footerNote")}>{data.contact?.footerNote}</span></p>
    </footer>

    <a class="float-linkedin" href={data.contact?.linkedinUrl} target="_blank" rel="noopener" aria-label="Visit on LinkedIn">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
      </svg>
    </a>

    <div class="modal-backdrop" id="contact-modal">
      <div class="modal-panel glass glass-strong">
        <button class="modal-close" data-close-contact aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <div class="modal-head">
          <p class="modal-eyebrow mono">Reach {data.contact?.footerName?.split(" ")[0] ?? "me"}</p>
          <h3>Let's get in touch</h3>
        </div>

        <div class="modal-body">
          <div class="modal-quick">
            <div class="modal-options">
              <a class="modal-option opt-linkedin" href={data.contact?.linkedinUrl} target="_blank" rel="noopener">
                <span class="icon-wrap">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
                  </svg>
                </span>
                <span class="text-wrap">
                  <span class="label">LinkedIn</span>
                  <small data-tina-field={tinaField(data.contact, "linkedinUrl")}>Connect professionally</small>
                </span>
              </a>
              <a class="modal-option opt-email" href={`mailto:${data.contact?.email}`}>
                <span class="icon-wrap">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2.5"/>
                    <path d="M3.5 6.5l8.5 6 8.5-6"/>
                  </svg>
                </span>
                <span class="text-wrap">
                  <span class="label">Email</span>
                  <small data-tina-field={tinaField(data.contact, "email")}>{data.contact?.email}</small>
                </span>
              </a>
            </div>
          </div>

          <div class="modal-main">
            <div class="modal-divider">or send a message directly</div>

            <form class="contact-form" id="contact-form">
              <div class="form-row">
                <div class="form-field">
                  <label for="cf-name">Full name</label>
                  <input type="text" id="cf-name" name="name" placeholder="Jane Doe" autocomplete="name" required>
                </div>
                <div class="form-field">
                  <label for="cf-email">Email address</label>
                  <input type="email" id="cf-email" name="email" placeholder="jane@email.com" autocomplete="email" required>
                </div>
              </div>
              <div class="form-field">
                <label for="cf-message">Message</label>
                <textarea id="cf-message" name="message" rows="3" placeholder="Say hello, ask a question, or share an opportunity..." required></textarea>
              </div>
              <button type="submit" class="btn btn-primary btn-block">Send me a message</button>
            </form>

            <div class="message-preview" id="message-preview" hidden>
              <p class="modal-eyebrow mono">Preview</p>
              <h3>Ready to send?</h3>
              <div class="preview-card glass">
                <div class="preview-row">
                  <span class="preview-label">To</span>
                  <span class="preview-value">{data.contact?.footerName}</span>
                </div>
                <div class="preview-row">
                  <span class="preview-label">From</span>
                  <span class="preview-value" id="preview-from"></span>
                </div>
                <div class="preview-row preview-message">
                  <span class="preview-label">Message</span>
                  <p class="preview-value" id="preview-message"></p>
                </div>
              </div>
              <div class="preview-actions">
                <button type="button" class="btn btn-ghost btn-sm" id="preview-edit">Edit</button>
                <button type="button" class="btn btn-primary btn-sm" id="preview-confirm">Confirm &amp; send</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </>
)}
